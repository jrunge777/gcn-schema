{
  "$id": "https://gcn.nasa.gov/schema/main/gcn/notices/heasarc/alert_base.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "HEASARC - Data in Archive",
  "description": "Data Archived at HEASARC",
  "allOf": [
    { "$ref": "../core/Alert.schema.json" },
    { "$ref": "../core/DateTime.schema.json" },
    { "$ref": "../core/Event.schema.json" },
    { "$ref": "../core/Reporter.schema.json" },
    { "$ref": "../ivoa/ObsCore.schema.json" }
  ],
  "properties": {
    "data_archive_s3": {
      "type": "string",
      "description": "The base URL of the AWS S3 bucket mirroring the data."
    },
    "mission_page": {
      "type": "string",
      "description": "Web page of the creator mission at HEASARC"
    }
  }
}
